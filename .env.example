# Copy to .env.local and fill in. Never commit .env.local.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Pooled connection used by the app at runtime
DATABASE_URL=postgresql://user:password@localhost:5432/freelancer_finance
# Direct connection used only for migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/freelancer_finance

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Defaults ---
# ISO 4217 code used for new users until they change it in settings
DEFAULT_CURRENCY=PHP

# --- Email provider (Phase 4) ---
# Resend API key for verification & password reset emails. Leave empty in local dev to log to console.
RESEND_API_KEY=
EMAIL_FROM="Freelancer Finance Tracker <noreply@freelancerfinancetracker.com>"
REQUIRE_EMAIL_VERIFICATION=false

# --- Optional: file storage for receipts (Phase 4) ---
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_ENDPOINT=

# --- Optional: maintenance cron job secret ---
# CRON_SECRET=

# --- Optional: error monitoring ---
# SENTRY_DSN=
